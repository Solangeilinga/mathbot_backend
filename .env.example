# ── Serveur ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Origine(s) autorisée(s) pour le CORS — l'URL de votre frontend (Vite en dev)
# Plusieurs origines séparées par des virgules, ex : http://localhost:5173,https://monapp.com
CORS_ORIGIN=http://localhost:5173

# ── Base de données PostgreSQL ────────────────────────────────────────────────
# Option A : URL complète (recommandé, ex. Supabase / Neon / Render)
DATABASE_URL=postgresql://user:password@localhost:5432/bepcmath

# Option B : variables séparées (utilisées si DATABASE_URL absent)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bepcmath
# Mettre à "true" si votre fournisseur exige SSL (Supabase, Neon, Render...)
PGSSL=false

# ── Authentification ──────────────────────────────────────────────────────────
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# ── IA (au moins une des deux clés est requise) ───────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=AIza...         # requis aussi pour la vision (analyse d'image) et le RAG

# ── Synthèse vocale (optionnel) ───────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
